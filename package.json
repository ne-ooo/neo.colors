{
  "name": "@lpm.dev/neo.colors",
  "version": "1.0.0",
  "description": "Zero-dependency terminal colors - Fast, modern, tree-shakeable alternative to chalk",
  "type": "module",
  "author": "neo",
  "license": "MIT",
  "keywords": [
    "colors",
    "chalk",
    "terminal",
    "ansi",
    "color",
    "style",
    "neo",
    "cli",
    "console",
    "formatting",
    "modern",
    "typescript",
    "zero-dependency",
    "tree-shakeable"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ne-ooo/neo.colors"
  },
  "bugs": {
    "url": "https://github.com/ne-ooo/neo.colors/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/index.js",
    "dist/index.cjs",
    "dist/index.d.ts",
    "dist/index.d.cts",
    ".lpm",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "bench": "vitest bench",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "chalk": "^4.1.2"
  },
  "homepage": "https://github.com/ne-ooo/neo.colors#readme"
}
